# Active chain: 46630 (Robinhood testnet) or 4663 (mainnet)
NEXT_PUBLIC_CHAIN_ID=46630

# Deployed BountyEscrow address. Leave empty to run in preview mode (sample data).
NEXT_PUBLIC_BOUNTY_ESCROW_ADDRESS=

# Comma-separated moderator wallets. They access /admin (report queue, hide
# bounties) and act as the dispute arbiter. On-chain, the arbiter is whatever
# address the contract was deployed with — keep the two in sync.
NEXT_PUBLIC_ADMIN_ADDRESSES=

# Secret for signing wallet-login sessions (any long random string, e.g.
# `openssl rand -hex 32`). Required in production; a random per-boot secret is
# used in dev (sessions reset on restart).
AUTH_SECRET=

# Postgres connection string (Neon, Vercel Postgres, Supabase, RDS…).
# Required on serverless hosts (Vercel) — the JSON fallback needs a writable
# disk. Leave empty for zero-config local dev with sample data.
# After setting it, create the tables once with: pnpm --filter @bountyhood/web db:push
DATABASE_URL=
