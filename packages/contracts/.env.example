# Deployer key (never commit a real key)
DEPLOYER_PRIVATE_KEY=0x...

# RPC overrides (defaults point at Robinhood Chain public RPCs)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_MAINNET_RPC=https://rpc.chain.robinhood.com/rpc

# Deployment config (all optional; defaults in scripts/deploy.js)
FEE_RECIPIENT=
ARBITER=
FEE_BPS=250
MIN_REWARD_ETH=0.001
DISPUTE_WINDOW_SEC=259200
